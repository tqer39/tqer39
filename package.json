{
  "name": "tqer39-devtools",
  "private": true,
  "description": "Development tool dependencies for tqer39 profile (run via lefthook).",
  "packageManager": "pnpm@12.12.0",
  "devDependencies": {
    "cspell": "10.3.6",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "rulesync": "29.0.0",
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-preset-smarthr": "1.38.2"
  },
  "scripts": {
    "rules:generate": "rulesync generate",
    "rules:check": "rulesync generate --check",
    "lint:js": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "LEFTHOOK_EXCLUDE=tests lefthook run pre-commit --all-files --no-stage-fixed --fail-on-changes",
    "test:tooling": "node tests/tooling.cjs",
    "test": "node scripts/run-tests.cjs",
    "check": "pnpm run lint && pnpm test"
  }
}
